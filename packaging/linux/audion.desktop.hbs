[Desktop Entry]
Categories={{categories}}
{{#if comment}}Comment={{comment}}
{{/if}}Exec=env GTK_MODULES= WEBKIT_FORCE_SANDBOX= WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 {{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
Actions=Play;Pause;Next;Previous;

[Desktop Action Play]
Name=Play
Exec=env GTK_MODULES= WEBKIT_FORCE_SANDBOX= WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 {{exec}} --play

[Desktop Action Pause]
Name=Pause
Exec=env GTK_MODULES= WEBKIT_FORCE_SANDBOX= WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 {{exec}} --pause

[Desktop Action Next]
Name=Next
Exec=env GTK_MODULES= WEBKIT_FORCE_SANDBOX= WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 {{exec}} --next

[Desktop Action Previous]
Name=Previous
Exec=env GTK_MODULES= WEBKIT_FORCE_SANDBOX= WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 {{exec}} --previous
